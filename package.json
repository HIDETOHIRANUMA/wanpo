{
  "name": "inu-to-suzumeru",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@expo/metro-runtime": "~58.0.17",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@supabase/supabase-js": "2.119.0",
    "expo": "~58.0.24",
    "expo-constants": "~58.0.16",
    "expo-crypto": "~58.0.8",
    "expo-dev-client": "~58.0.19",
    "expo-linking": "~58.0.17",
    "expo-location": "~58.0.21",
    "expo-network": "~58.0.5",
    "expo-router": "~58.0.31",
    "expo-status-bar": "~58.0.5",
    "expo-system-ui": "~58.0.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-maps": "1.29.11",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-web": "~0.21.4"
  },
  "devDependencies": {
    "@types/jest": "~30.0.0",
    "@types/node": "26.6.6",
    "@types/pg": "8.23.1",
    "@types/react": "~19.3.0",
    "eslint": "~9.39.5",
    "eslint-config-expo": "~58.0.4",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.14",
    "pg": "8.23.1",
    "tsx": "4.23.15",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "lint": "expo lint",
    "test": "jest",
    "test:rls": "bash scripts/test-rls.sh",
    "import:places": "tsx scripts/import-places.ts",
    "android:dev-build": "expo run:android",
    "ios:dev-build": "expo run:ios",
    "test:db": "bash scripts/test-db.sh"
  },
  "private": true,
  "jest": {
    "preset": "jest-expo",
    "testMatch": [
      "<rootDir>/src/**/__tests__/**/*.test.ts?(x)"
    ],
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/src/$1"
    },
    "setupFiles": [
      "<rootDir>/jest/setup.ts"
    ]
  }
}
