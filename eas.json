{
  "cli": { "version": ">= 16.0.0", "appVersionSource": "remote" },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": { "EXPO_PUBLIC_DATA_MODE": "demo" },
      "android": { "buildType": "apk" },
      "ios": { "simulator": false }
    },
    "development-simulator": {
      "extends": "development",
      "ios": { "simulator": true }
    },
    "preview": {
      "distribution": "internal",
      "env": { "EXPO_PUBLIC_DATA_MODE": "production" }
    },
    "production": {
      "env": { "EXPO_PUBLIC_DATA_MODE": "production" }
    }
  },
  "submit": { "production": {} }
}
