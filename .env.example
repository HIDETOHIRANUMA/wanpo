# ---- アプリに埋め込まれる値（EXPO_PUBLIC_ は誰でも読める。秘密情報を入れない）----
# demo | production（未設定なら demo）
EXPO_PUBLIC_DATA_MODE=demo
# 本番モードで必須
EXPO_PUBLIC_SUPABASE_URL=
# Supabase の publishable key（sb_publishable_...）。RLS で保護される公開用キー
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# 再確認をおすすめする日数（運用上の目安）
EXPO_PUBLIC_STALE_AFTER_DAYS=90
# 運営者名と問い合わせ先（利用規約・プライバシー画面に表示。ストア審査で必要。公開してよいものだけ）
EXPO_PUBLIC_OPERATOR_NAME=
EXPO_PUBLIC_SUPPORT_EMAIL=

# ---- ネイティブ設定（ビルド時のみ使用）----
# Android の Google Maps SDK 用キー。Android アプリ（パッケージ名＋SHA-1）と Maps SDK for Android に制限すること
GOOGLE_MAPS_ANDROID_API_KEY=
ANDROID_PACKAGE=com.example.inutosuzumeru
IOS_BUNDLE_IDENTIFIER=com.example.inutosuzumeru

# ---- ここより下はアプリに含めない（scripts/ やサーバー側だけで使う）----
# データ投入スクリプト用。Supabase の Database 接続文字列。絶対に EXPO_PUBLIC_ を付けない
# DATABASE_URL=postgresql://...
